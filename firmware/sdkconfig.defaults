# SenseCAP Watcher W1-A — ESP32-S3 hardware defaults
# Apply with: idf.py set-target esp32s3  (reads this file automatically)

# ── Flash ─────────────────────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ── Partition table (custom CSV with 3 MB app partitions) ─────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── PSRAM (OPI, embedded, AP_3v3) ────────────────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# ── Bluetooth (Bluedroid — required for BLE2902 / GATT server) ────────────────
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# Arduino BLE library uses legacy 4.2 advertising (esp_ble_gap_start_advertising)
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# ── FreeRTOS (arduino-esp32 requires 1000 Hz) ─────────────────────────────────
CONFIG_FREERTOS_HZ=1000

# ── mbedTLS: enable PSK so arduino NetworkClientSecure/ssl_client.cpp compiles
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# ── Arduino component ─────────────────────────────────────────────────────────
# app_main() calls initArduino() manually; do not autostart
CONFIG_AUTOSTART_ARDUINO=n
CONFIG_ARDUINO_LOOP_STACK_SIZE=16384
CONFIG_ARDUINO_RUNNING_CORE=1
CONFIG_ARDUINO_EVENT_RUNNING_CORE=0

# ── Serial / logging ──────────────────────────────────────────────────────────
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
